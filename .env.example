# API configuration (apps/api loads the root .env.local).
APP_ORIGIN=http://localhost:3000
PORT=4000
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Production requires PostgreSQL. Local development uses a persistent PGlite database when blank.
DATABASE_URL=
# Set a unique random value of at least 32 characters in production, on BOTH API and web.
API_PROXY_SECRET=
# Jupiter is server-only. Swaps remain disabled without a key and on devnet.
JUPITER_API_KEY=
TREASURY_ENABLED=false
# Independently verify the provider's official Solana mint and eligibility before enabling treasury trading.
SOLANA_RWA_MINT=

# Web server configuration (copy these into apps/web/.env.local for local development).
API_URL=http://localhost:4000
